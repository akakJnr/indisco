{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* One copy of the React types: the monorepo hoists React 19 types for the
       storefront, which clashes with the backend's own React 18 copy. */
    "baseUrl": ".",
    "paths": {
      "react": ["../../../../node_modules/@types/react"],
      "react/*": ["../../../../node_modules/@types/react/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    ".",
    "../../.medusa/types/plugin-augmentations.d.ts"
  ]
}